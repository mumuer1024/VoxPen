# VoxPen — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# 虚拟环境
venv/
.venv/
env/
env310/
runtime/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 模型权重（体积过大，不入库）
models/*
!models/.gitkeep
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# 运行时（exe 不入库，只保留 .gitkeep）
bin/*.exe
!bin/.gitkeep

# 用户产出
output/*
!output/.gitkeep

# 日志
logs/*
!logs/.gitkeep

# PyInstaller
*.spec
launcher/dist/
launcher/build/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.local

# 测试
.pytest_cache/
.coverage
htmlcov/

# 参考输出（Phase 2.0 产生）
references/qwen_asr_actual_api.txt

# 其他不重要文件
Phase-*-需求.md
references/开发参考资料.md
chat_export_*.md